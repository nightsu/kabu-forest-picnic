{
  "name": "kabu-forest-picnic",
  "version": "1.0.0",
  "private": true,
  "description": "A gentle, touch-friendly forest picnic game for little explorers.",
  "type": "module",
  "scripts": {
    "dev": "vp dev --host 127.0.0.1",
    "build": "node scripts/verify-audio.mjs && tsc --noEmit && vp build",
    "preview": "vp preview --host 127.0.0.1",
    "check": "vp check && tsc --noEmit",
    "format": "vp fmt",
    "test": "vp test run",
    "test:e2e": "node tests/browser.mjs",
    "deploy": "node scripts/deploy.mjs",
    "audio:plan": "node scripts/generate-voices.mjs",
    "audio:generate": "node scripts/generate-voices.mjs --generate",
    "audio:check": "node scripts/verify-audio.mjs",
    "test:audio": "node tests/audio-browser.mjs"
  },
  "dependencies": {
    "motion": "14.0.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "playwright": "1.63.0",
    "typescript": "7.0.2",
    "vite-plus": "1.0.0"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@1.0.0",
    "vitest": "5.0.1"
  },
  "engines": {
    "node": "^22.18.0 || ^24.11.0 || >=26.0.0"
  }
}
